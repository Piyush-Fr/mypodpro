# ============================================================
# myPod Pro - Environment Configuration Template
# ============================================================

# 1. Neon PostgreSQL Database URL
# Sign up at https://neon.tech and create a project, then paste your connection string:
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Better Auth Secret
# Generate a random 32+ character string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=your_32_character_minimum_random_secret_string_here

# 3. Application Base URLs
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
